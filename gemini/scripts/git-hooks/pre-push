#!/bin/sh
# Refuses to push commits that aren't the repository owner's or that name an
# AI tool, and new branches not named task/..., feature/... or bugfix/...
# (AGENTS.md, "Commits, branches and pull requests"). The rules are in
# gemini/scripts/commit-policy.sh, which Gemini CI's policy job runs too. Then
# runs Git LFS's own pre-push step, which this replaces. Installed by
# gemini/scripts/git-hooks/install.sh.

remote_name=$1
remote_url=$2
zero='0000000000000000000000000000000000000000'
policy="$(git rev-parse --show-toplevel)/gemini/scripts/commit-policy.sh"
refs=$(cat)
failed=0

if [ ! -f "$policy" ]; then
	echo >&2 "pre-push: $policy is missing, so the commit rules were not checked."
else
	while read -r local_ref local_sha remote_ref remote_sha; do
		[ -z "$local_sha" ] && continue
		case "$local_sha" in "$zero") continue ;; esac
		# A new branch starts with task/, feature/ or bugfix/; branches GitHub already has keep their names.
		if [ "$remote_sha" = "$zero" ]; then
			case "$remote_ref" in
				refs/tags/*) ;;
				*) sh "$policy" branch "${remote_ref#refs/heads/}" >&2 || failed=1 ;;
			esac
		fi
		# Only commits no remote has yet: what is already there stays as it is. That
		# leaves out main's commits that a merge of origin/main brings in, such as
		# GitHub's merge commits. The branch's old tip and its history are left out
		# too, for a remote this clone has no tracking refs for.
		set -- "$local_sha" --not --remotes
		if [ "$remote_sha" != "$zero" ] && git rev-parse --quiet --verify "$remote_sha^{commit}" >/dev/null; then
			set -- "$@" "$remote_sha"
		fi
		sh "$policy" commits "$@" >&2 || failed=1
	done <<REFS
$refs
REFS
fi

[ "$failed" = 0 ] || { echo >&2 "pre-push: nothing was pushed."; exit 1; }

# Gemini CI's quick checks for what the pushed branches change (gemini/scripts/ci-checks.sh):
# lint of the changed files, hygiene, the patch series and the type checks. CI runs the rest on
# the push; GEMINI_FULL_CHECKS=1 runs it here too. Not for a deleted branch or a tag, and not
# with GEMINI_SKIP_CHECKS=1.
checks="$(git rev-parse --show-toplevel)/gemini/scripts/ci-checks.sh"
pushes_branch=0
while read -r local_ref local_sha remote_ref remote_sha; do
	case "$local_sha:$remote_ref" in
		"$zero":* | :* | *:refs/tags/*) ;;
		*) pushes_branch=1 ;;
	esac
done <<REFS
$refs
REFS
if [ "$pushes_branch" = 1 ] && [ "${GEMINI_SKIP_CHECKS:-}" != 1 ]; then
	if [ ! -f "$checks" ]; then
		echo >&2 "pre-push: $checks is missing, so CI's checks were not run."
	elif ! bash "$checks" >&2; then
		echo >&2 "pre-push: nothing was pushed. Fix what failed, or push with GEMINI_SKIP_CHECKS=1 to leave it to CI."
		exit 1
	fi
fi

if command -v git-lfs >/dev/null 2>&1; then
	printf '%s\n' "$refs" | git lfs pre-push "$remote_name" "$remote_url"
fi
