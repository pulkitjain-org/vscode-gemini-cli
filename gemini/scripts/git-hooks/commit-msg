#!/bin/sh
# Keeps AI attribution out of commit messages, and commits under the
# repository owner's identity (AGENTS.md, "Commits, branches and pull requests").
# The rules themselves are in gemini/scripts/commit-policy.sh, which Gemini CI
# runs too. Installed by gemini/scripts/git-hooks/install.sh.

owner='er.pulkit@gmail.com'
message="$1"
policy="$(git rev-parse --show-toplevel)/gemini/scripts/commit-policy.sh"

# A tool's trailers and footers go, wherever a tool added them (the one list is in the policy script);
# anything else that names a tool is the writer's to reword.
if [ -f "$policy" ]; then
	sh "$policy" strip "$message"
fi
if [ -f "$policy" ] && ! sh "$policy" message "$message" >&2; then
	echo >&2 "commit-msg: the commit was not made. Your message is in $(git rev-parse --git-dir)/COMMIT_EDITMSG."
	exit 1
fi

email() {
	git var "$1" | sed -n 's/^.*<\(.*\)>.*$/\1/p'
}
for who in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
	address=$(email "$who")
	if [ "$address" != "$owner" ]; then
		echo >&2 "commit-msg: commits here are made as $owner, not $address ($who)."
		echo >&2 "Commit with the configured git user; never pass --author or set GIT_AUTHOR_*/GIT_COMMITTER_*."
		exit 1
	fi
done
exit 0
