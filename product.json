	"extensionConfigurationPolicy": {
		"gemini.cliPath": {
			"name": "GeminiCliPath",
			"category": "Extensions",
			"minimumVersion": "1.141",
			"localization": {
				"description": {
					"key": "gemini.cliPath.policy",
					"value": "Path to the Gemini CLI that GeminiCode runs. Set it to an empty string, with GeminiCliVersion, to pin GeminiCode's own copy."
				}
			}
		},
		"gemini.cli.version": {
			"name": "GeminiCliVersion",
			"category": "Extensions",
			"minimumVersion": "1.141",
			"localization": {
				"description": {
					"key": "gemini.cli.version.policy",
					"value": "The version of GeminiCode's own copy of the Gemini CLI to run, such as 0.62.0."
				}
			}
		},
		"gemini.cli.checkForUpdates": {
			"name": "GeminiCliCheckForUpdates",
			"category": "Extensions",
			"minimumVersion": "1.141",
			"localization": {
				"description": {
					"key": "gemini.cli.checkForUpdates.policy",
					"value": "Whether GeminiCode checks the npm registry once a day for a newer Gemini CLI and offers to install it."
				}
			}
		},
		"gemini.inlineEdit.enabled": {
			"name": "GeminiInlineEdit",
			"category": "Extensions",
			"minimumVersion": "1.141",
			"localization": {
				"description": {
					"key": "gemini.inlineEdit.enabled.policy",
					"value": "Whether GeminiCode offers inline edit and commit messages, which send the selected code or the diff straight to Gemini with the CLI's saved sign-in."
				}
			}
		},
		"gemini.usageMeter.enabled": {
			"name": "GeminiUsageMeter",
			"category": "Extensions",
			"minimumVersion": "1.141",
			"localization": {
				"description": {
					"key": "gemini.usageMeter.enabled.policy",
					"value": "Whether GeminiCode reads today's Gemini quota use for its status bar, with the CLI's saved sign-in."
				}
			}
		},
		"gemini.app.checkForUpdates": {
			"name": "GeminiCodeCheckForUpdates",
			"category": "Extensions",
			"minimumVersion": "1.141",
			"localization": {
				"description": {
					"key": "gemini.app.checkForUpdates.policy",
					"value": "Whether GeminiCode checks its download page once a day for a newer GeminiCode and tells the user."
				}
			}
		},
		"gemini.approval.allowAutoEdit": {
			"name": "GeminiAllowAutoEdit",
			"category": "Extensions",
			"minimumVersion": "1.141",
			"localization": {
				"description": {
					"key": "gemini.approval.allowAutoEdit.policy",
					"value": "Whether GeminiCode offers the Auto Edit approval mode, which applies file edits without asking."
				}
			}
		},
		"gemini.approval.allowYolo": {
			"name": "GeminiAllowYolo",
			"category": "Extensions",
			"minimumVersion": "1.141",
			"localization": {
				"description": {
					"key": "gemini.approval.allowYolo.policy",
					"value": "Whether GeminiCode offers the YOLO approval mode, which runs every tool without asking."
				}
			}
		},
		"gemini.tools.allowShell": {
			"name": "GeminiAllowShell",
			"category": "Extensions",
			"minimumVersion": "1.141",
			"localization": {
				"description": {
					"key": "gemini.tools.allowShell.policy",
					"value": "Whether the Gemini agent in GeminiCode may run shell commands."
				}
			}
		},
		"gemini.browser.enabled": {
			"name": "GeminiBrowser",
			"category": "Extensions",
			"minimumVersion": "1.141",
			"localization": {
				"description": {
					"key": "gemini.browser.enabled.policy",
					"value": "Whether Gemini agents in GeminiCode can open and use pages in the integrated browser."
				}
			}
		},
		"gemini.browser.allowOtherSites": {
			"name": "GeminiBrowserOtherSites",
			"category": "Extensions",
			"minimumVersion": "1.141",
			"localization": {
				"description": {
					"key": "gemini.browser.allowOtherSites.policy",
					"value": "Whether Gemini agents may open sites other than localhost in the integrated browser, after asking the user. When off, they can only open local pages."
				}
			}
		}
	}
}
