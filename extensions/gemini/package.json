{
  "name": "gemini",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "gemini-fork",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension",
  "contributes": {
    "commands": [
      {
        "command": "gemini.openChat",
        "title": "%command.openChat%",
        "category": "%category%"
      },
      {
        "command": "gemini.restartAgent",
        "title": "%command.restartAgent%",
        "category": "%category%"
      },
      {
        "command": "gemini.setProjectId",
        "title": "%command.setProjectId%",
        "category": "%category%"
      },
      {
        "command": "gemini.completeSetupInTerminal",
        "title": "%command.completeSetupInTerminal%",
        "category": "%category%"
      },
      {
        "command": "gemini.checkAgent",
        "title": "%command.checkAgent%",
        "category": "%category%"
      },
      {
        "command": "gemini.showLog",
        "title": "%command.showLog%",
        "category": "%category%"
      },
      {
        "command": "gemini.showStatusMenu",
        "title": "%command.showStatusMenu%",
        "category": "%category%"
      },
      {
        "command": "gemini.newChat",
        "title": "%command.newChat%",
        "category": "%category%",
        "icon": "$(add)",
        "enablement": "!gemini.chatBusy"
      },
      {
        "command": "gemini.addFileToChat",
        "title": "%command.addFileToChat%",
        "category": "%category%",
        "icon": "$(attach)"
      },
      {
        "command": "gemini.addSelectionToChat",
        "title": "%command.addSelectionToChat%",
        "category": "%category%"
      },
      {
        "command": "gemini.agents.newAgent",
        "title": "%command.agents.newAgent%",
        "category": "%category%",
        "icon": "$(add)"
      },
      {
        "command": "gemini.agents.addWorkspace",
        "title": "%command.agents.addWorkspace%",
        "category": "%category%",
        "icon": "$(new-folder)"
      },
      {
        "command": "gemini.agents.open",
        "title": "%command.agents.open%",
        "category": "%category%"
      },
      {
        "command": "gemini.agents.rename",
        "title": "%command.agents.rename%",
        "category": "%category%"
      },
      {
        "command": "gemini.agents.stop",
        "title": "%command.agents.stop%",
        "category": "%category%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "gemini.agents.remove",
        "title": "%command.agents.remove%",
        "category": "%category%"
      },
      {
        "command": "gemini.agents.removeWorkspace",
        "title": "%command.agents.removeWorkspace%",
        "category": "%category%"
      }
    ],
    "keybindings": [
      {
        "command": "gemini.addSelectionToChat",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && editorHasSelection && resourceScheme == file"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gemini",
          "title": "%viewContainer.title%",
          "icon": "media/gemini.svg"
        }
      ]
    },
    "views": {
      "gemini": [
        {
          "id": "gemini.agents",
          "name": "%view.agents%"
        },
        {
          "type": "webview",
          "id": "gemini.chat",
          "name": "%view.chat%"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "gemini.addFileToChat",
          "when": "!explorerResourceIsFolder && resourceScheme == file",
          "group": "gemini@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "gemini.addFileToChat",
          "when": "resourceScheme == file",
          "group": "gemini@1"
        }
      ],
      "editor/context": [
        {
          "command": "gemini.addSelectionToChat",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "gemini@1"
        },
        {
          "command": "gemini.addFileToChat",
          "when": "!editorHasSelection && resourceScheme == file",
          "group": "gemini@1"
        }
      ],
      "view/title": [
        {
          "command": "gemini.newChat",
          "when": "view == gemini.chat",
          "group": "navigation"
        },
        {
          "command": "gemini.restartAgent",
          "when": "view == gemini.chat",
          "group": "agent@1"
        },
        {
          "command": "gemini.showLog",
          "when": "view == gemini.chat",
          "group": "agent@2"
        },
        {
          "command": "gemini.agents.newAgent",
          "when": "view == gemini.agents",
          "group": "navigation@1"
        },
        {
          "command": "gemini.agents.addWorkspace",
          "when": "view == gemini.agents",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "gemini.agents.newAgent",
          "when": "view == gemini.agents && viewItem =~ /^workspace/",
          "group": "inline"
        },
        {
          "command": "gemini.agents.stop",
          "when": "view == gemini.agents && viewItem == agent.busy",
          "group": "inline"
        },
        {
          "command": "gemini.agents.newAgent",
          "when": "view == gemini.agents && viewItem =~ /^workspace/",
          "group": "1_agent@1"
        },
        {
          "command": "gemini.agents.removeWorkspace",
          "when": "view == gemini.agents && viewItem == workspace",
          "group": "2_remove@1"
        },
        {
          "command": "gemini.agents.rename",
          "when": "view == gemini.agents && viewItem =~ /^agent/",
          "group": "1_agent@1"
        },
        {
          "command": "gemini.agents.stop",
          "when": "view == gemini.agents && viewItem == agent.busy",
          "group": "1_agent@2"
        },
        {
          "command": "gemini.agents.remove",
          "when": "view == gemini.agents && viewItem =~ /^agent/",
          "group": "2_remove@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gemini.agents.open",
          "when": "false"
        },
        {
          "command": "gemini.agents.rename",
          "when": "false"
        },
        {
          "command": "gemini.agents.stop",
          "when": "false"
        },
        {
          "command": "gemini.agents.remove",
          "when": "false"
        },
        {
          "command": "gemini.agents.removeWorkspace",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "gemini.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%configuration.cliPath%"
        },
        "gemini.projectId": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "%configuration.projectId%"
        }
      }
    },
    "configurationDefaults": {
      "chat.disableAIFeatures": true
    },
    "viewsWelcome": [
      {
        "view": "gemini.agents",
        "contents": "%viewsWelcome.agents%"
      }
    ]
  },
  "scripts": {
    "compile": "gulp compile-extension:gemini",
    "watch": "gulp watch-extension:gemini",
    "typecheck-tests": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "24.x",
    "@vscode/codicons": "^0.0.36",
    "markdown-it": "^14.3.2",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pulkitjain-org/vscode-gemini-cli.git"
  }
}
