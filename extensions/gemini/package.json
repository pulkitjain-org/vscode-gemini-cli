{
  "name": "gemini",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "gemini-fork",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension",
  "contributes": {
    "commands": [
      {
        "command": "gemini.appearance",
        "title": "%command.appearance%",
        "category": "%category%"
      },
      {
        "command": "gemini.toggleFollowAgent",
        "title": "%command.toggleFollowAgent%",
        "category": "%category%"
      },
      {
        "command": "gemini.openChatAsMarkdown",
        "title": "%command.openChatAsMarkdown%",
        "category": "%category%"
      },
      {
        "command": "gemini.agents.openAsMarkdown",
        "title": "%command.openChatAsMarkdown%",
        "category": "%category%"
      },
      {
        "command": "gemini.newSkill",
        "title": "%command.newSkill%",
        "category": "%category%"
      },
      {
        "command": "gemini.openChat",
        "title": "%command.openChat%",
        "category": "%category%"
      },
      {
        "command": "gemini.restartAgent",
        "title": "%command.restartAgent%",
        "category": "%category%"
      },
      {
        "command": "gemini.installCli",
        "title": "%command.installCli%",
        "category": "%category%"
      },
      {
        "command": "gemini.installCliVersion",
        "title": "%command.installCliVersion%",
        "category": "%category%"
      },
      {
        "command": "gemini.setProjectId",
        "title": "%command.setProjectId%",
        "category": "%category%"
      },
      {
        "command": "gemini.signIn",
        "title": "%command.signIn%",
        "category": "%category%"
      },
      {
        "command": "gemini.getStarted",
        "title": "%command.getStarted%",
        "category": "%category%"
      },
      {
        "command": "gemini.completeSetupInTerminal",
        "title": "%command.completeSetupInTerminal%",
        "category": "%category%"
      },
      {
        "command": "gemini.checkAgent",
        "title": "%command.checkAgent%",
        "category": "%category%"
      },
      {
        "command": "gemini.showLog",
        "title": "%command.showLog%",
        "category": "%category%"
      },
      {
        "command": "gemini.showStatusMenu",
        "title": "%command.showStatusMenu%",
        "category": "%category%"
      },
      {
        "command": "gemini.newChat",
        "title": "%command.newChat%",
        "category": "%category%",
        "icon": "$(add)",
        "enablement": "!gemini.chatBusy"
      },
      {
        "command": "gemini.addFileToChat",
        "title": "%command.addFileToChat%",
        "category": "%category%",
        "icon": "$(attach)"
      },
      {
        "command": "gemini.addSelectionToChat",
        "title": "%command.addSelectionToChat%",
        "category": "%category%"
      },
      {
        "command": "gemini.enhancePrompt",
        "title": "%command.enhancePrompt%",
        "category": "%category%"
      },
      {
        "command": "gemini.agents.newAgent",
        "title": "%command.agents.newAgent%",
        "category": "%category%",
        "icon": "$(add)"
      },
      {
        "command": "gemini.agents.newAgentOnBranch",
        "title": "%command.agents.newAgentOnBranch%",
        "category": "%category%",
        "icon": "$(git-branch)"
      },
      {
        "command": "gemini.agentHome",
        "title": "%command.agentHome%",
        "category": "%category%",
        "icon": "$(home)"
      },
      {
        "command": "gemini.reviewChanges",
        "title": "%command.reviewChanges%",
        "category": "%category%",
        "icon": "$(checklist)"
      },
      {
        "command": "gemini.projectSettings",
        "title": "%command.projectSettings%",
        "category": "%category%",
        "icon": "$(server-environment)"
      },
      {
        "command": "gemini.agents.addWorkspace",
        "title": "%command.agents.addWorkspace%",
        "category": "%category%",
        "icon": "$(new-folder)"
      },
      {
        "command": "gemini.agents.open",
        "title": "%command.agents.open%",
        "category": "%category%"
      },
      {
        "command": "gemini.agents.openChanges",
        "title": "%command.agents.openChanges%",
        "category": "%category%",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "gemini.agents.mergeBack",
        "title": "%command.agents.mergeBack%",
        "category": "%category%",
        "icon": "$(git-merge)"
      },
      {
        "command": "gemini.agents.rename",
        "title": "%command.agents.rename%",
        "category": "%category%"
      },
      {
        "command": "gemini.agents.stop",
        "title": "%command.agents.stop%",
        "category": "%category%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "gemini.agents.remove",
        "title": "%command.agents.remove%",
        "category": "%category%"
      },
      {
        "command": "gemini.agents.removeWorkspace",
        "title": "%command.agents.removeWorkspace%",
        "category": "%category%"
      },
      {
        "command": "gemini.changes.openAll",
        "title": "%command.changes.openAll%",
        "category": "%category%",
        "icon": "$(diff-multiple)",
        "enablement": "gemini.agentHasChanges"
      },
      {
        "command": "gemini.inlineEdit",
        "title": "%command.inlineEdit%",
        "category": "%category%",
        "icon": "$(sparkle)",
        "enablement": "config.gemini.inlineEdit.enabled"
      },
      {
        "command": "gemini.generateCommitMessage",
        "title": "%command.generateCommitMessage%",
        "category": "%category%",
        "icon": "$(sparkle)",
        "enablement": "config.gemini.inlineEdit.enabled"
      },
      {
        "command": "gemini.review.previousChange",
        "title": "%command.review.previousChange%",
        "category": "%category%",
        "icon": "$(arrow-up)",
        "enablement": "gemini.review.active"
      },
      {
        "command": "gemini.review.nextChange",
        "title": "%command.review.nextChange%",
        "category": "%category%",
        "icon": "$(arrow-down)",
        "enablement": "gemini.review.active"
      },
      {
        "command": "gemini.review.keepFile",
        "title": "%command.review.keepFile%",
        "category": "%category%",
        "icon": "$(check-all)",
        "enablement": "gemini.review.active"
      },
      {
        "command": "gemini.review.undoFile",
        "title": "%command.review.undoFile%",
        "category": "%category%",
        "icon": "$(discard)",
        "enablement": "gemini.review.active"
      },
      {
        "command": "gemini.review.keepChange",
        "title": "%command.review.keepChange%",
        "category": "%category%"
      },
      {
        "command": "gemini.review.undoChange",
        "title": "%command.review.undoChange%",
        "category": "%category%"
      },
      {
        "command": "gemini.review.nextFile",
        "title": "%command.review.nextFile%",
        "category": "%category%"
      },
      {
        "command": "gemini.changes.clear",
        "title": "%command.changes.clear%",
        "category": "%category%",
        "icon": "$(clear-all)",
        "enablement": "gemini.agentHasChanges"
      },
      {
        "command": "gemini.changes.openFile",
        "title": "%command.changes.openFile%",
        "category": "%category%"
      }
    ],
    "walkthroughs": [
      {
        "id": "gemini.getStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "cli",
            "title": "%walkthrough.cli.title%",
            "description": "%walkthrough.cli.description%",
            "media": { "markdown": "walkthrough/cli.md" },
            "completionEvents": ["onContext:gemini.setup.cliReady"]
          },
          {
            "id": "signIn",
            "title": "%walkthrough.signIn.title%",
            "description": "%walkthrough.signIn.description%",
            "media": { "markdown": "walkthrough/signIn.md" },
            "completionEvents": ["onContext:gemini.setup.signedIn"]
          },
          {
            "id": "project",
            "title": "%walkthrough.project.title%",
            "description": "%walkthrough.project.description%",
            "media": { "markdown": "walkthrough/project.md" },
            "completionEvents": ["onContext:gemini.setup.projectReady"]
          },
          {
            "id": "look",
            "title": "%walkthrough.look.title%",
            "description": "%walkthrough.look.description%",
            "media": { "markdown": "walkthrough/look.md" },
            "completionEvents": ["onCommand:gemini.appearance"]
          },
          {
            "id": "agent",
            "title": "%walkthrough.agent.title%",
            "description": "%walkthrough.agent.description%",
            "media": { "markdown": "walkthrough/agent.md" },
            "completionEvents": ["onCommand:gemini.agents.newAgent"]
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "gemini.addSelectionToChat",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && editorHasSelection && resourceScheme == file"
      },
      {
        "command": "gemini.inlineEdit",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && !editorReadonly && resourceScheme == file && config.gemini.inlineEdit.enabled"
      },
      {
        "command": "gemini.openChat",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorHasSelection"
      },
      {
        "command": "gemini.enhancePrompt",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "!webviewFocus"
      },
      {
        "command": "gemini.agents.newAgent",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "gemini.newChat",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "focusedView == gemini.chat"
      },
      {
        "command": "gemini.review.keepFile",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "gemini.review.active && editorTextFocus"
      },
      {
        "command": "gemini.review.undoFile",
        "key": "ctrl+backspace",
        "mac": "cmd+backspace",
        "when": "gemini.review.active && editorTextFocus"
      },
      {
        "command": "gemini.review.nextChange",
        "key": "alt+]",
        "when": "gemini.review.active && editorTextFocus"
      },
      {
        "command": "gemini.review.previousChange",
        "key": "alt+[",
        "when": "gemini.review.active && editorTextFocus"
      },
      {
        "command": "gemini.agents.rename",
        "key": "f2",
        "mac": "enter",
        "when": "focusedView == gemini.agents && !inputFocus"
      },
      {
        "command": "gemini.agents.open",
        "key": "cmd+down",
        "when": "isMac && focusedView == gemini.agents && !inputFocus"
      },
      {
        "command": "gemini.agents.remove",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == gemini.agents"
      }
     ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gemini",
          "title": "%viewContainer.title%",
          "icon": "media/gemini.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "geminiChanges",
          "title": "%viewContainer.changes%",
          "icon": "$(diff-multiple)"
        }
      ]
    },
    "views": {
      "gemini": [
        {
          "id": "gemini.agents",
          "name": "%view.agents%",
          "initialSize": 2
        },
        {
          "id": "gemini.agentChanges",
          "name": "%view.agentChanges%",
          "initialSize": 1,
          "when": "gemini.mode != agents"
        },
        {
          "type": "webview",
          "id": "gemini.chat",
          "name": "%view.chat%",
          "initialSize": 3,
          "visibility": "collapsed"
        }
      ],
      "geminiChanges": [
        {
          "type": "webview",
          "id": "gemini.changesPanel",
          "name": "%view.changesPanel%",
          "when": "gemini.mode == agents"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "gemini.addFileToChat",
          "when": "!explorerResourceIsFolder && resourceScheme == file",
          "group": "gemini@1"
        }
      ],
      "editor/title": [
        {
          "command": "gemini.review.previousChange",
          "when": "gemini.review.active && resourceScheme == file",
          "group": "navigation@1"
        },
        {
          "command": "gemini.review.nextChange",
          "when": "gemini.review.active && resourceScheme == file",
          "group": "navigation@2"
        },
        {
          "command": "gemini.review.keepFile",
          "when": "gemini.review.active && resourceScheme == file",
          "group": "navigation@3"
        },
        {
          "command": "gemini.review.undoFile",
          "when": "gemini.review.active && resourceScheme == file",
          "group": "navigation@4"
        }
      ],
      "editor/title/context": [
        {
          "command": "gemini.addFileToChat",
          "when": "resourceScheme == file",
          "group": "gemini@1"
        }
      ],
      "scm/title": [
        {
          "command": "gemini.generateCommitMessage",
          "when": "scmProvider == git && config.gemini.inlineEdit.enabled",
          "group": "navigation@1"
        },
        {
          "command": "gemini.reviewChanges",
          "when": "scmProvider == git",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "gemini.inlineEdit",
          "when": "!editorReadonly && resourceScheme == file && config.gemini.inlineEdit.enabled",
          "group": "gemini@0"
        },
        {
          "command": "gemini.addSelectionToChat",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "gemini@1"
        },
        {
          "command": "gemini.addFileToChat",
          "when": "!editorHasSelection && resourceScheme == file",
          "group": "gemini@1"
        }
      ],
      "view/title": [
        {
          "command": "gemini.newChat",
          "when": "view == gemini.chat",
          "group": "navigation"
        },
        {
          "command": "gemini.restartAgent",
          "when": "view == gemini.chat",
          "group": "agent@1"
        },
        {
          "command": "gemini.showLog",
          "when": "view == gemini.chat",
          "group": "agent@2"
        },
        {
          "command": "gemini.openChatAsMarkdown",
          "when": "view == gemini.chat",
          "group": "chat@1"
        },
        {
          "command": "gemini.agents.newAgent",
          "when": "view == gemini.agents",
          "group": "navigation@1"
        },
        {
          "command": "gemini.agents.addWorkspace",
          "when": "view == gemini.agents",
          "group": "navigation@2"
        },
        {
          "command": "gemini.agentHome",
          "when": "view == gemini.agents",
          "group": "navigation@3"
        },
        {
          "command": "gemini.reviewChanges",
          "when": "view == gemini.agents",
          "group": "helpers@1"
        },
        {
          "command": "gemini.projectSettings",
          "when": "view == gemini.agents",
          "group": "helpers@2"
        },
        {
          "command": "gemini.changes.openAll",
          "when": "view == gemini.agentChanges",
          "group": "navigation@1"
        },
        {
          "command": "gemini.changes.clear",
          "when": "view == gemini.agentChanges",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "gemini.agents.newAgent",
          "when": "view == gemini.agents && viewItem =~ /^workspace/",
          "group": "inline"
        },
        {
          "command": "gemini.agents.newAgentOnBranch",
          "when": "view == gemini.agents && viewItem =~ /^workspace.*\\.git$/",
          "group": "inline"
        },
        {
          "command": "gemini.agents.openChanges",
          "when": "view == gemini.agents && viewItem =~ /\\.changes$/",
          "group": "inline"
        },
        {
          "command": "gemini.agents.mergeBack",
          "when": "view == gemini.agents && viewItem =~ /\\.worktree/",
          "group": "inline"
        },
        {
          "command": "gemini.agents.stop",
          "when": "view == gemini.agents && viewItem =~ /^agent\\.busy/",
          "group": "inline"
        },
        {
          "command": "gemini.agents.newAgent",
          "when": "view == gemini.agents && viewItem =~ /^workspace/",
          "group": "1_agent@1"
        },
        {
          "command": "gemini.agents.newAgentOnBranch",
          "when": "view == gemini.agents && viewItem =~ /^workspace.*\\.git$/",
          "group": "1_agent@2"
        },
        {
          "command": "gemini.agents.removeWorkspace",
          "when": "view == gemini.agents && viewItem =~ /^workspace(\\.git)?$/",
          "group": "2_remove@1"
        },
        {
          "command": "gemini.agents.rename",
          "when": "view == gemini.agents && viewItem =~ /^agent/",
          "group": "1_agent@1"
        },
        {
          "command": "gemini.agents.openChanges",
          "when": "view == gemini.agents && viewItem =~ /\\.changes$/",
          "group": "1_agent@2"
        },
        {
          "command": "gemini.agents.stop",
          "when": "view == gemini.agents && viewItem =~ /^agent\\.busy/",
          "group": "1_agent@3"
        },
        {
          "command": "gemini.agents.mergeBack",
          "when": "view == gemini.agents && viewItem =~ /\\.worktree/",
          "group": "1_agent@4"
        },
        {
          "command": "gemini.agents.openAsMarkdown",
          "when": "view == gemini.agents && viewItem =~ /^agent/",
          "group": "1_agent@5"
        },
        {
          "command": "gemini.agents.remove",
          "when": "view == gemini.agents && viewItem =~ /^agent/",
          "group": "2_remove@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gemini.review.keepChange",
          "when": "false"
        },
        {
          "command": "gemini.review.undoChange",
          "when": "false"
        },
        {
          "command": "gemini.review.nextFile",
          "when": "false"
        },
        {
          "command": "gemini.agents.open",
          "when": "false"
        },
        {
          "command": "gemini.agents.rename",
          "when": "false"
        },
        {
          "command": "gemini.agents.stop",
          "when": "false"
        },
        {
          "command": "gemini.agents.remove",
          "when": "false"
        },
        {
          "command": "gemini.agents.removeWorkspace",
          "when": "false"
        },
        {
          "command": "gemini.agents.mergeBack",
          "when": "false"
        },
        {
          "command": "gemini.agents.openAsMarkdown",
          "when": "false"
        },
        {
          "command": "gemini.agents.openChanges",
          "when": "false"
        },
        {
          "command": "gemini.changes.openFile",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "gemini.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%configuration.cliPath%"
        },
        "gemini.cli.version": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "pattern": "^$|^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
          "markdownDescription": "%configuration.cli.version%"
        },
        "gemini.cli.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "%configuration.cli.checkForUpdates%"
        },
        "gemini.app.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "%configuration.app.checkForUpdates%"
        },
        "gemini.agents.ownBranch": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%configuration.agents.ownBranch%"
        },
        "gemini.agents.worktreeSetup": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%configuration.agents.worktreeSetup%"
        },
        "gemini.chat.followAgent": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "%configuration.chat.followAgent%"
        },
        "gemini.browser.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "%configuration.browser.enabled%"
        },
        "gemini.browser.allowOtherSites": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "%configuration.browser.allowOtherSites%"
        },
        "gemini.keepAwake": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "%configuration.keepAwake%"
        },
        "gemini.inlineEdit.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "%configuration.inlineEdit.enabled%"
        },
        "gemini.usageMeter.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "%configuration.usageMeter.enabled%"
        },
        "gemini.inlineEdit.model": {
          "type": "string",
          "default": "latestFlash",
          "scope": "machine",
          "markdownDescription": "%configuration.inlineEdit.model%"
        },
        "gemini.approval.allowAutoEdit": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "%configuration.approval.allowAutoEdit%"
        },
        "gemini.approval.allowYolo": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "%configuration.approval.allowYolo%"
        },
        "gemini.tools.allowShell": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "%configuration.tools.allowShell%"
        },
        "gemini.projectId": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "%configuration.projectId%"
        },
        "gemini.appearance.accent": {
          "type": "string",
          "default": "theme",
          "enum": ["theme", "blue", "violet", "rose", "teal", "amber", "gradient"],
          "enumItemLabels": ["%configuration.appearance.accent.theme%", "%configuration.appearance.accent.blue%", "%configuration.appearance.accent.violet%", "%configuration.appearance.accent.rose%", "%configuration.appearance.accent.teal%", "%configuration.appearance.accent.amber%", "%configuration.appearance.accent.gradient%"],
          "scope": "application",
          "markdownDescription": "%configuration.appearance.accent%"
        },
        "gemini.chat.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 10,
          "maximum": 24,
          "scope": "application",
          "markdownDescription": "%configuration.chat.fontSize%"
        },
        "gemini.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "%configuration.notifications.enabled%"
        },
        "gemini.layout.showAgentsInNewWorkspaces": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "%configuration.layout.showAgentsInNewWorkspaces%"
        }
